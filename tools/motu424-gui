class Meter(Gtk.DrawingArea):
    ZONES = ((0.00, 0.70, (0.18, 0.82, 0.44)),
             (0.70, 0.88, (0.96, 0.65, 0.15)),
             (0.88, 1.00, (0.96, 0.26, 0.28)))

    def __init__(self):
        super().__init__()
        self.level, self.peak, self.clip = 0.0, 0.0, False
        self.set_content_width(12)
        self.set_vexpand(True)
        self.set_valign(Gtk.Align.FILL)
        self.set_size_request(12, 160)
        self.set_draw_func(self._draw)
        click = Gtk.GestureClick()
        click.connect("pressed", self._clear_clip)
        self.add_controller(click)
        self.set_tooltip_text("Peak Meter (Click to clear clip)")

    def set_level(self, v):
        v = max(0.0, min(1.0, v))
        self.level = v
        if v > self.peak:
            self.peak = v
        if v >= CLIP_AT:
            self.clip = True
        self.queue_draw()

    def decay(self, dt):
        if self.peak > 0.0:
            self.peak = max(self.level, self.peak - PEAK_DECAY * dt)
            self.queue_draw()

    def _clear_clip(self, *_):
        self.clip = False
        self.queue_draw()

    def _draw(self, _area, cr, w, h):
        lamp_h = 7
        bar_h = h - lamp_h - 3
        # Recessed bezel background
        cr.set_source_rgb(0.05, 0.07, 0.09)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Clip indicator lamp
        if self.clip:
            cr.set_source_rgb(1.0, 0.20, 0.22)
            cr.rectangle(0, 0, w, lamp_h)
            cr.fill()
            cr.set_source_rgb(1.0, 0.85, 0.85)
            cr.rectangle(w / 2.0 - 1, lamp_h / 2.0 - 1, 2, 2)
            cr.fill()
        else:
            cr.set_source_rgb(0.18, 0.07, 0.08)
            cr.rectangle(0, 0, w, lamp_h)
            cr.fill()

        # LED Zone fills
        top = lamp_h + 3
        lvl_y = top + bar_h * (1.0 - self.level)
        for z0, z1, rgb in self.ZONES:
            y1 = top + bar_h * (1.0 - z0)
            y0 = top + bar_h * (1.0 - z1)
            lit_y0 = max(y0, lvl_y)
            if lit_y0 < y1:
                cr.set_source_rgb(*rgb)
                cr.rectangle(0, lit_y0, w, y1 - lit_y0)
                cr.fill()
            dim = tuple(c * 0.12 for c in rgb)
            if y0 < lit_y0:
                cr.set_source_rgb(*dim)
                cr.rectangle(0, y0, w, min(lit_y0, y1) - y0)
                cr.fill()

        # LED Segmentation ticks
        cr.set_source_rgb(0.04, 0.05, 0.07)
        y = top
        while y < top + bar_h:
            cr.rectangle(0, y, w, 1)
            y += 3.5
        cr.fill()

        # Peak line needle
        if self.peak > 0.0:
            cr.set_source_rgb(0.85, 0.95, 1.0)
            cr.rectangle(0, top + bar_h * (1.0 - self.peak) - 1, w, 2)
            cr.fill()


class DbScale(Gtk.DrawingArea):
    POINTS = [
        (0.000, "+6", (0.95, 0.40, 0.40), True),
        (0.106, "",   (0.40, 0.50, 0.60), False),
        (0.213, " 0", (0.35, 0.85, 1.00), True),
        (0.338, "",   (0.40, 0.50, 0.60), False),
        (0.441, "-6", (0.75, 0.85, 0.95), True),
        (0.525, "",   (0.40, 0.50, 0.60), False),
        (0.606, "-12",(0.65, 0.75, 0.85), True),
        (0.724, "",   (0.40, 0.50, 0.60), False),
        (0.803, "-24",(0.55, 0.65, 0.75), True),
        (0.898, "",   (0.40, 0.50, 0.60), False),
        (1.000, "-∞", (0.45, 0.55, 0.65), True),
    ]

    def __init__(self, compact=False):
        super().__init__()
        self.compact = compact
        width = 18 if compact else 22
        self.set_content_width(width)
        self.set_vexpand(True)
        self.set_valign(Gtk.Align.FILL)
        self.set_size_request(width, 140)
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, w, h):
        # Dark studio fader bed
        cr.set_source_rgb(0.06, 0.08, 0.10)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Side divider border towards fader track
        cr.set_source_rgb(0.16, 0.21, 0.27)
        cr.move_to(w - 1, 0)
        cr.line_to(w - 1, h)
        cr.set_line_width(1.0)
        cr.stroke()

        # Divider border towards meter
        cr.set_source_rgb(0.12, 0.16, 0.20)
        cr.move_to(0, 0)
        cr.line_to(0, h)
        cr.set_line_width(1.0)
        cr.stroke()

        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7 if self.compact else 8)

        # Standard fader track slider offset padding: 11px
        pad_top = 11.0
        avail_h = max(10.0, h - 22.0)

        for frac, txt, rgb, is_major in self.POINTS:
            y = pad_top + frac * avail_h

            if txt == " 0":
                # Prominent Unity 0 dB marking line across
                cr.set_source_rgba(0.25, 0.75, 1.00, 0.95)
                cr.move_to(w - 6, y)
                cr.line_to(w, y)
                cr.set_line_width(1.5)
                cr.stroke()

                cr.move_to(0, y)
                cr.line_to(4, y)
                cr.set_line_width(1.2)
                cr.stroke()
            elif is_major:
                cr.set_source_rgb(*rgb)
                # Tick pointing to fader
                cr.move_to(w - 4, y)
                cr.line_to(w, y)
                cr.set_line_width(1.0)
                cr.stroke()

                # Tick pointing to meter
                cr.move_to(0, y)
                cr.line_to(2.5, y)
                cr.set_line_width(0.8)
                cr.stroke()
            else:
                # Minor tick mark pointing to fader
                cr.set_source_rgba(0.40, 0.50, 0.60, 0.6)
                cr.move_to(w - 2.5, y)
                cr.line_to(w, y)
                cr.set_line_width(0.8)
                cr.stroke()

            # Text label
            if txt:
                cr.set_source_rgb(*rgb)
                x_pos = 1 if self.compact else 3
                cr.move_to(x_pos, y + 2.5)
                cr.show_text(txt)


class Knob(Gtk.DrawingArea):
    SWEEP = math.radians(135)

    def __init__(self, lo, hi, value, on_change):
        super().__init__()
        self.lo, self.hi = lo, hi
        self.value = max(lo, min(hi, value))
        self.on_change = on_change
        self._v0 = self.value
        self.set_content_width(32)
        self.set_content_height(32)
        self.set_draw_func(self._draw)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", lambda *_: setattr(self, "_v0", self.value))
        drag.connect("drag-update", self._drag)
        self.add_controller(drag)

        scroll = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self._scroll)
        self.add_controller(scroll)

        dbl = Gtk.GestureClick()
        dbl.connect("pressed", lambda _g, n, _x, _y: self._set(0) if n == 2 else None)
        self.add_controller(dbl)

    def set_value_silent(self, v):
        self.value = max(self.lo, min(self.hi, v))
        self.queue_draw()

    def _set(self, v):
        v = max(self.lo, min(self.hi, int(round(v))))
        if v != self.value:
            self.value = v
            self.queue_draw()
            self.on_change(v)

    def _drag(self, gesture, _dx, dy):
        frac = (self.hi - self.lo) / 120.0
        self._set(self._v0 - dy * frac)

    def _scroll(self, _ctrl, _dx, dy):
        step = max(1, (self.hi - self.lo) // 25)
        self._set(self.value - (step if dy > 0 else -step))
        return True

    def _draw(self, _area, cr, w, h):
        cx, cy = w / 2.0, h / 2.0
        r = min(w, h) / 2.0 - 4.0
        track_r = r + 2.5

        # Outer arc track
        cr.arc(cx, cy, track_r, -math.pi/2.0 - self.SWEEP, -math.pi/2.0 + self.SWEEP)
        cr.set_source_rgb(0.10, 0.13, 0.17)
        cr.set_line_width(2.5)
        cr.stroke()

        # Active fill arc
        norm = (self.value - self.lo) / float(self.hi - self.lo) if self.hi > self.lo else 0.5
        ang = -math.pi / 2.0 + (norm * 2.0 - 1.0) * self.SWEEP
        if self.value < 0:
            cr.arc(cx, cy, track_r, ang, -math.pi/2.0)
            cr.set_source_rgb(0.25, 0.72, 1.0)
            cr.set_line_width(2.5)
            cr.stroke()
        elif self.value > 0:
            cr.arc(cx, cy, track_r, -math.pi/2.0, ang)
            cr.set_source_rgb(0.25, 0.72, 1.0)
            cr.set_line_width(2.5)
            cr.stroke()
        else:
            cr.set_source_rgb(0.70, 0.85, 1.0)
            cr.move_to(cx, cy - track_r - 1.5)
            cr.line_to(cx, cy - track_r + 1.5)
            cr.set_line_width(1.5)
            cr.stroke()

        # Knob dial body
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgb(0.14, 0.17, 0.21)
        cr.fill_preserve()
        cr.set_source_rgb(0.28, 0.35, 0.44)
        cr.set_line_width(1.2)
        cr.stroke()

        # Pointer needle
        ix = cx + (r - 2) * math.cos(ang)
        iy = cy + (r - 2) * math.sin(ang)
        cr.move_to(cx, cy)
        cr.line_to(ix, iy)
        cr.set_source_rgb(0.92, 0.96, 1.0)
        cr.set_line_width(2.0)
        cr.stroke()

        # Center hub
        cr.arc(cx, cy, 2.5, 0, 2 * math.pi)
        cr.set_source_rgb(0.25, 0.32, 0.40)
        cr.fill()


class EqBand:
    def __init__(self, band_id, name, kind, enabled, freq, gain=0.0, q=1.0, f_min=20.0, f_max=20000.0, color=(0.5, 0.5, 0.5), label=""):
        self.band_id = band_id
        self.name = name
        self.kind = kind          # 'hpf', 'low_shelf', 'peak', 'high_shelf'
        self.enabled = enabled
        self.freq = freq
        self.gain = gain
        self.q = q
        self.f_min = f_min
        self.f_max = f_max
        self.color = color        # (r, g, b)
        self.label = label


class VisualEQ(Gtk.DrawingArea):
    """
    Interactive Studio Parametric Equalizer Visual Display.
    Renders logarithmic frequency response curves (20 Hz - 20 kHz),
    with individual biquad band contributions, composite summed curve
    with glowing gradient fill, dB reference grid, and interactive
    draggable/hoverable filter nodes with mouse-wheel Q bandwidth control.
    """
    MIN_FREQ = 20.0
    MAX_FREQ = 20000.0
    LOG_MIN = math.log10(MIN_FREQ)
    LOG_MAX = math.log10(MAX_FREQ)
    LOG_SPAN = LOG_MAX - LOG_MIN

    MIN_DB = -18.0
    MAX_DB = 18.0
    DB_SPAN = MAX_DB - MIN_DB

    PAD_L = 42
    PAD_R = 18
    PAD_T = 24
    PAD_B = 26

    FREQ_TICKS = [
        (30, "30"), (50, "50"), (100, "100"), (250, "250"),
        (500, "500"), (1000, "1k"), (2500, "2.5k"),
        (5000, "5k"), (10000, "10k"), (20000, "20k")
    ]
    DB_TICKS = [
        (12, "+12"), (6, "+6"), (0, " 0"), (-6, "-6"), (-12, "-12")
    ]

    PRESETS = {
        "flat": {
            "name": "Flat / Reset (0 dB)",
            "bands": [
                (False, 80.0, 0.0, 0.707),
                (True, 100.0, 0.0, 0.707),
                (True, 400.0, 0.0, 1.0),
                (True, 2500.0, 0.0, 1.4),
                (True, 8000.0, 0.0, 0.707),
            ]
        },
        "vocal": {
            "name": "Vocal Clarity & Presence",
            "bands": [
                (True, 90.0, 0.0, 0.707),
                (True, 120.0, 1.0, 0.707),
                (True, 350.0, -2.5, 1.2),
                (True, 3200.0, 3.5, 1.4),
                (True, 10000.0, 4.0, 0.707),
            ]
        },
        "acoustic": {
            "name": "Acoustic Guitar Sparkle",
            "bands": [
                (True, 80.0, 0.0, 0.707),
                (True, 100.0, -1.0, 0.707),
                (True, 240.0, -3.5, 1.6),
                (True, 2800.0, 2.0, 1.2),
                (True, 8500.0, 3.5, 0.707),
            ]
        },
        "kick": {
            "name": "Kick Drum Punch & Beater",
            "bands": [
                (True, 35.0, 0.0, 0.707),
                (True, 65.0, 4.5, 0.707),
                (True, 380.0, -4.5, 1.8),
                (True, 2800.0, 3.0, 1.5),
                (True, 10000.0, -2.0, 0.707),
            ]
        },
        "snare": {
            "name": "Snare Crack & Body",
            "bands": [
                (True, 80.0, 0.0, 0.707),
                (True, 200.0, 2.5, 0.707),
                (True, 800.0, -3.0, 2.0),
                (True, 4500.0, 3.5, 1.4),
                (True, 9000.0, 2.0, 0.707),
            ]
        },
        "bass": {
            "name": "Bass Guitar Tight & Warm",
            "bands": [
                (True, 35.0, 0.0, 0.707),
                (True, 90.0, 3.5, 0.707),
                (True, 320.0, -3.0, 1.4),
                (True, 1200.0, 2.0, 1.5),
                (True, 5000.0, -2.5, 0.707),
            ]
        },
        "electric_gtr": {
            "name": "Electric Guitar Crunch",
            "bands": [
                (True, 90.0, 0.0, 0.707),
                (True, 140.0, -1.5, 0.707),
                (True, 700.0, -3.5, 1.5),
                (True, 2600.0, 3.0, 1.2),
                (True, 7500.0, -2.0, 0.707),
            ]
        }
    }

    def __init__(self, on_band_changed=None):
        super().__init__()
        self.on_band_changed = on_band_changed
        self.bypassed = False

        self.bands = [
            EqBand("hpf", "High-Pass", "hpf", False, 80.0, 0.0, 0.707, 20.0, 500.0, (0.20, 0.82, 0.95), "HP"),
            EqBand("low_shelf", "Low Shelf", "low_shelf", True, 100.0, 0.0, 0.707, 20.0, 1000.0, (0.28, 0.58, 0.98), "LF"),
            EqBand("low_mid", "Low-Mid Peak", "peak", True, 400.0, 0.0, 1.0, 80.0, 4000.0, (0.22, 0.85, 0.48), "LM"),
            EqBand("high_mid", "High-Mid Peak", "peak", True, 2500.0, 0.0, 1.4, 400.0, 12000.0, (0.98, 0.72, 0.15), "HM"),
            EqBand("high_shelf", "High Shelf", "high_shelf", True, 8000.0, 0.0, 0.707, 1500.0, 20000.0, (0.85, 0.38, 0.85), "HF")
        ]

        self._active_drag = None
        self._drag_start_freq = 0.0
        self._drag_start_gain = 0.0
        self._hover_band = None
        self._mouse_x = 0
        self._mouse_y = 0

        self.set_content_height(260)
        self.set_size_request(420, 250)
        self.set_vexpand(False)
        self.set_hexpand(True)
        self.set_draw_func(self._draw)

        # Gestures & Controllers
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        drag.connect("drag-end", self._on_drag_end)
        self.add_controller(drag)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        motion.connect("leave", self._on_leave)
        self.add_controller(motion)

        scroll = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self._on_scroll)
        self.add_controller(scroll)

        dbl = Gtk.GestureClick()
        dbl.connect("pressed", self._on_click)
        self.add_controller(dbl)

    def freq_to_x(self, freq, w):
        f = max(self.MIN_FREQ, min(self.MAX_FREQ, freq))
        norm = (math.log10(f) - self.LOG_MIN) / self.LOG_SPAN
        return self.PAD_L + norm * (w - self.PAD_L - self.PAD_R)

    def x_to_freq(self, x, w):
        avail = w - self.PAD_L - self.PAD_R
        if avail <= 0:
            return 1000.0
        norm = max(0.0, min(1.0, (x - self.PAD_L) / avail))
        return 10 ** (self.LOG_MIN + norm * self.LOG_SPAN)

    def db_to_y(self, db, h):
        d = max(self.MIN_DB, min(self.MAX_DB, db))
        norm = (self.MAX_DB - d) / self.DB_SPAN
        return self.PAD_T + norm * (h - self.PAD_T - self.PAD_B)

    def y_to_db(self, y, h):
        avail = h - self.PAD_T - self.PAD_B
        if avail <= 0:
            return 0.0
        norm = max(0.0, min(1.0, (y - self.PAD_T) / avail))
        return self.MAX_DB - norm * self.DB_SPAN

    def _eval_band(self, f, b):
        if not b.enabled or self.bypassed:
            return 0.0
        if b.kind == "hpf":
            ratio = f / max(1.0, b.freq)
            term = ratio ** 4
            return max(-40.0, 10.0 * math.log10(term / (1.0 + term)))
        elif b.kind == "low_shelf":
            r = f / max(1.0, b.freq)
            return b.gain / (1.0 + r * r)
        elif b.kind == "high_shelf":
            r = f / max(1.0, b.freq)
            r2 = r * r
            return (b.gain * r2) / (1.0 + r2)
        elif b.kind == "peak":
            dx = b.q * (f / max(1.0, b.freq) - max(1.0, b.freq) / max(1.0, f))
            return b.gain / (1.0 + dx * dx)
        return 0.0

    def _get_node_pos(self, i, w, h):
        b = self.bands[i]
        x = self.freq_to_x(b.freq, w)
        if b.kind == "hpf":
            y = self.db_to_y(-3.0 if b.enabled else 0.0, h)
        else:
            y = self.db_to_y(b.gain, h)
        return x, y

    def _find_nearest_band(self, x, y, w, h, max_dist=22.0):
        best_i = None
        best_d = max_dist
        for i in range(len(self.bands)):
            nx, ny = self._get_node_pos(i, w, h)
            d = math.hypot(x - nx, y - ny)
            if d < best_d:
                best_d = d
                best_i = i
        return best_i

    def _on_drag_begin(self, _gesture, start_x, start_y):
        w = self.get_width()
        h = self.get_height()
        idx = self._find_nearest_band(start_x, start_y, w, h)
        if idx is not None:
            self._active_drag = idx
            self._drag_start_freq = self.bands[idx].freq
            self._drag_start_gain = self.bands[idx].gain
            self.queue_draw()

    def _on_drag_update(self, gesture, offset_x, offset_y):
        if self._active_drag is None:
            return
        w = self.get_width()
        h = self.get_height()
        _ok, start_x, start_y = gesture.get_start_point()
        new_x = start_x + offset_x
        new_y = start_y + offset_y
        b = self.bands[self._active_drag]
        new_f = self.x_to_freq(new_x, w)
        b.freq = max(b.f_min, min(b.f_max, new_f))
        if b.kind != "hpf":
            new_g = self.y_to_db(new_y, h)
            b.gain = max(self.MIN_DB, min(self.MAX_DB, round(new_g * 2.0) / 2.0))
        self.queue_draw()
        if self.on_band_changed:
            self.on_band_changed(self._active_drag, b)

    def _on_drag_end(self, _gesture, _ox, _oy):
        self._active_drag = None
        self.queue_draw()

    def _on_motion(self, _ctrl, x, y):
        w = self.get_width()
        h = self.get_height()
        self._mouse_x = x
        self._mouse_y = y
        idx = self._find_nearest_band(x, y, w, h)
        if idx != self._hover_band:
            self._hover_band = idx
            self.queue_draw()

    def _on_leave(self, _ctrl):
        if self._hover_band is not None:
            self._hover_band = None
            self.queue_draw()

    def _on_scroll(self, _ctrl, _dx, dy):
        target = self._active_drag if self._active_drag is not None else self._hover_band
        if target is not None:
            b = self.bands[target]
            if b.kind == "peak":
                b.q = max(0.4, min(6.0, round((b.q - dy * 0.1) * 10.0) / 10.0))
                self.queue_draw()
                if self.on_band_changed:
                    self.on_band_changed(target, b)
                return True
        return False

    def _on_click(self, _gesture, n_press, x, y):
        if n_press == 2:
            w = self.get_width()
            h = self.get_height()
            idx = self._find_nearest_band(x, y, w, h)
            if idx is not None:
                b = self.bands[idx]
                if b.kind == "hpf":
                    b.enabled = not b.enabled
                else:
                    b.gain = 0.0
                self.queue_draw()
                if self.on_band_changed:
                    self.on_band_changed(idx, b)

    def set_band_silent(self, idx, freq=None, gain=None, q=None, enabled=None):
        if 0 <= idx < len(self.bands):
            b = self.bands[idx]
            if freq is not None:
                b.freq = max(b.f_min, min(b.f_max, float(freq)))
            if gain is not None:
                b.gain = max(self.MIN_DB, min(self.MAX_DB, float(gain)))
            if q is not None:
                b.q = max(0.4, min(6.0, float(q)))
            if enabled is not None:
                b.enabled = bool(enabled)
            self.queue_draw()

    def set_bypass(self, bypassed):
        self.bypassed = bool(bypassed)
        self.queue_draw()

    def _draw(self, _area, cr, w, h):
        # 1. Dark Console Background
        pat = cairo.LinearGradient(0, 0, 0, h)
        pat.add_color_stop_rgb(0.0, 0.07, 0.09, 0.12)
        pat.add_color_stop_rgb(1.0, 0.04, 0.05, 0.07)
        cr.set_source(pat)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Outer border
        cr.rectangle(0.5, 0.5, w - 1, h - 1)
        cr.set_source_rgba(0.20, 0.26, 0.34, 0.8)
        cr.set_line_width(1.0)
        cr.stroke()

        # 2. Gridlines - Frequency (X)
        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(8.5)
        for freq, txt in self.FREQ_TICKS:
            x = self.freq_to_x(freq, w)
            cr.set_source_rgba(0.20, 0.28, 0.38, 0.25)
            cr.move_to(x, self.PAD_T)
            cr.line_to(x, h - self.PAD_B)
            cr.set_line_width(0.8)
            cr.stroke()

            # Axis tick label
            cr.set_source_rgba(0.50, 0.62, 0.75, 0.70)
            cr.move_to(x - 8, h - self.PAD_B + 14)
            cr.show_text(txt)

        # Gridlines - Decibels (Y)
        y_zero = self.db_to_y(0.0, h)
        for db, txt in self.DB_TICKS:
            y = self.db_to_y(db, h)
            if db == 0:
                cr.set_source_rgba(0.35, 0.75, 1.0, 0.38)
                cr.set_line_width(1.2)
            else:
                cr.set_source_rgba(0.20, 0.28, 0.38, 0.20)
                cr.set_line_width(0.8)
            cr.move_to(self.PAD_L, y)
            cr.line_to(w - self.PAD_R, y)
            cr.stroke()

            cr.set_source_rgba(0.50, 0.62, 0.75, 0.70)
            cr.move_to(8, y + 3)
            cr.show_text(txt)

        # 3. Individual Band Response Curves (Faint colored curves)
        if not self.bypassed:
            for b in self.bands:
                if b.enabled and (abs(b.gain) > 0.1 or b.kind == "hpf"):
                    r, g, b_col = b.color
                    cr.set_source_rgba(r, g, b_col, 0.35)
                    cr.set_line_width(1.2)
                    started = False
                    for i in range(121):
                        f = 20.0 * (1000.0 ** (i / 120.0))
                        g_val = self._eval_band(f, b)
                        x = self.freq_to_x(f, w)
                        y = self.db_to_y(g_val, h)
                        if not started:
                            cr.move_to(x, y)
                            started = True
                        else:
                            cr.line_to(x, y)
                    cr.stroke()

        # 4. Master Summed Frequency Response Curve
        pts = []
        for i in range(161):
            f = 20.0 * (1000.0 ** (i / 160.0))
            tot_g = sum(self._eval_band(f, b) for b in self.bands)
            x = self.freq_to_x(f, w)
            y = self.db_to_y(tot_g, h)
            pts.append((x, y))

        if pts:
            # Gradient fill underneath curve to 0 dB line
            cr.move_to(pts[0][0], y_zero)
            for x, y in pts:
                cr.line_to(x, y)
            cr.line_to(pts[-1][0], y_zero)
            cr.close_path()

            grad = cairo.LinearGradient(0, self.PAD_T, 0, h - self.PAD_B)
            if self.bypassed:
                grad.add_color_stop_rgba(0.0, 0.4, 0.45, 0.5, 0.12)
                grad.add_color_stop_rgba(1.0, 0.2, 0.25, 0.3, 0.02)
            else:
                grad.add_color_stop_rgba(0.0, 0.15, 0.85, 0.95, 0.28)
                grad.add_color_stop_rgba(0.5, 0.10, 0.60, 0.80, 0.14)
                grad.add_color_stop_rgba(1.0, 0.05, 0.30, 0.50, 0.03)
            cr.set_source(grad)
            cr.fill()

            # Master Curve Stroke
            cr.move_to(pts[0][0], pts[0][1])
            for x, y in pts[1:]:
                cr.line_to(x, y)
            if self.bypassed:
                cr.set_source_rgba(0.50, 0.55, 0.65, 0.5)
            else:
                cr.set_source_rgba(0.20, 0.92, 0.98, 0.95)
            cr.set_line_width(2.6)
            cr.stroke()

        # 5. Interactive Filter Nodes
        active_target = self._active_drag if self._active_drag is not None else self._hover_band

        # If a band is active/hovered, draw crosshairs first
        if active_target is not None and 0 <= active_target < len(self.bands):
            b = self.bands[active_target]
            nx, ny = self._get_node_pos(active_target, w, h)
            r, g, b_col = b.color
            # Crosshair guides
            cr.set_source_rgba(r, g, b_col, 0.30)
            cr.set_line_width(1.0)
            cr.move_to(nx, self.PAD_T); cr.line_to(nx, h - self.PAD_B); cr.stroke()
            cr.move_to(self.PAD_L, ny); cr.line_to(w - self.PAD_R, ny); cr.stroke()

        # Draw all nodes
        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        for i, b in enumerate(self.bands):
            nx, ny = self._get_node_pos(i, w, h)
            is_active = (i == active_target)
            r, g, b_col = b.color

            # Outer aura / glow if hovered or dragged
            if is_active:
                cr.arc(nx, ny, 16, 0, 2 * math.pi)
                cr.set_source_rgba(r, g, b_col, 0.25)
                cr.fill()

            # Node body
            node_r = 10.0 if is_active else 8.0
            cr.arc(nx, ny, node_r, 0, 2 * math.pi)
            cr.set_source_rgba(0.08, 0.10, 0.14, 0.95)
            cr.fill_preserve()
            if b.enabled:
                cr.set_source_rgb(r, g, b_col)
            else:
                cr.set_source_rgba(0.4, 0.45, 0.5, 0.6)
            cr.set_line_width(2.2 if is_active else 1.8)
            cr.stroke()

            # Text label inside node (HP, LF, LM, HM, HF)
            cr.set_font_size(7.0 if is_active else 6.5)
            if b.enabled:
                cr.set_source_rgb(r, g, b_col)
            else:
                cr.set_source_rgba(0.5, 0.55, 0.6, 0.8)
            cr.move_to(nx - 4.5, ny + 2.5)
            cr.show_text(b.label)

        # 6. Floating HUD Tooltip Badge for active node
        if active_target is not None and 0 <= active_target < len(self.bands):
            b = self.bands[active_target]
            nx, ny = self._get_node_pos(active_target, w, h)
            r, g, b_col = b.color

            freq_str = f"{int(b.freq)} Hz" if b.freq < 1000 else f"{b.freq/1000:.1f} kHz"
            q_str = f"  •  Q: {b.q:.1f}" if b.kind == "peak" else ""
            gain_str = f"{b.gain:+.1f} dB" if b.kind != "hpf" else ("12 dB/oct" if b.enabled else "OFF")
            hud_text = f"{b.name.upper()} : {freq_str}  |  {gain_str}{q_str}"

            cr.set_font_size(9.5)
            extents = cr.text_extents(hud_text)
            bw = extents.width + 18
            bh = 22
            bx = max(self.PAD_L, min(w - self.PAD_R - bw, nx - bw / 2.0))
            by = ny - 28 if ny > self.PAD_T + 35 else ny + 18

            # Dark rounded card
            cr.rectangle(bx, by, bw, bh)
            cr.set_source_rgba(0.08, 0.10, 0.14, 0.95)
            cr.fill_preserve()
            cr.set_source_rgb(r, g, b_col)
            cr.set_line_width(1.2)
            cr.stroke()

            # Text inside badge
            cr.set_source_rgb(0.95, 0.98, 1.0)
            cr.move_to(bx + 9, by + 15)
            cr.show_text(hud_text)


class VisualDynamics(Gtk.DrawingArea):
    """
    Interactive Studio Dynamics / Compressor Visual Display.
    Renders the Input vs. Output transfer function curve in dB,
    with adjustable threshold knee, compression ratio slope, soft-knee
    polynomial transition, makeup gain offset, gain reduction shading,
    and a real-time Gain Reduction (GR) LED meter.
    """
    IN_MIN = -50.0
    IN_MAX = 0.0
    IN_SPAN = 50.0

    OUT_MIN = -50.0
    OUT_MAX = 10.0
    OUT_SPAN = 60.0

    PAD_L = 42
    PAD_R = 52
    PAD_T = 22
    PAD_B = 26

    PRESETS = {
        "vocal": {
            "name": "Studio Vocal Leveler",
            "threshold": -18.0,
            "ratio": 3.5,
            "attack": 15.0,
            "release": 180.0,
            "makeup": 4.0,
            "knee": 6.0
        },
        "drum_smash": {
            "name": "Drum Smash & Punch",
            "threshold": -24.0,
            "ratio": 8.0,
            "attack": 3.0,
            "release": 60.0,
            "makeup": 8.0,
            "knee": 2.0
        },
        "master_glue": {
            "name": "Master Bus Glue",
            "threshold": -10.0,
            "ratio": 2.0,
            "attack": 30.0,
            "release": 120.0,
            "makeup": 1.5,
            "knee": 8.0
        },
        "acoustic": {
            "name": "Acoustic Instrument",
            "threshold": -14.0,
            "ratio": 2.5,
            "attack": 25.0,
            "release": 250.0,
            "makeup": 2.0,
            "knee": 6.0
        },
        "snare": {
            "name": "Snare Crack & Snap",
            "threshold": -16.0,
            "ratio": 5.0,
            "attack": 8.0,
            "release": 80.0,
            "makeup": 5.0,
            "knee": 4.0
        },
        "bass": {
            "name": "Bass Guitar Tightener",
            "threshold": -20.0,
            "ratio": 4.0,
            "attack": 10.0,
            "release": 150.0,
            "makeup": 6.0,
            "knee": 6.0
        },
        "limiter": {
            "name": "Brickwall Peak Limiter",
            "threshold": -4.0,
            "ratio": 20.0,
            "attack": 0.5,
            "release": 40.0,
            "makeup": 3.0,
            "knee": 1.0
        },
        "flat": {
            "name": "Bypass / Flat (1:1)",
            "threshold": 0.0,
            "ratio": 1.0,
            "attack": 10.0,
            "release": 200.0,
            "makeup": 0.0,
            "knee": 4.0
        }
    }

    def __init__(self, on_params_changed=None):
        super().__init__()
        self.on_params_changed = on_params_changed
        self.enabled = True

        self.threshold = -16.0
        self.ratio = 4.0
        self.attack = 10.0
        self.release = 200.0
        self.makeup = 0.0
        self.knee = 6.0

        self._active_drag = None   # 'threshold' or 'ratio'
        self._hover_node = None    # 'threshold' or 'ratio'
        self._mouse_x = 0
        self._mouse_y = 0

        self.set_content_height(240)
        self.set_size_request(420, 240)
        self.set_vexpand(False)
        self.set_hexpand(True)
        self.set_draw_func(self._draw)

        # Gestures & Controllers
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._on_drag_begin)
        drag.connect("drag-update", self._on_drag_update)
        drag.connect("drag-end", self._on_drag_end)
        self.add_controller(drag)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self._on_motion)
        motion.connect("leave", self._on_leave)
        self.add_controller(motion)

        scroll = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self._on_scroll)
        self.add_controller(scroll)

        dbl = Gtk.GestureClick()
        dbl.connect("pressed", self._on_click)
        self.add_controller(dbl)

    def in_db_to_x(self, db, w):
        d = max(self.IN_MIN, min(self.IN_MAX, db))
        norm = (d - self.IN_MIN) / self.IN_SPAN
        return self.PAD_L + norm * (w - self.PAD_L - self.PAD_R)

    def x_to_in_db(self, x, w):
        avail = w - self.PAD_L - self.PAD_R
        if avail <= 0:
            return -20.0
        norm = max(0.0, min(1.0, (x - self.PAD_L) / avail))
        return self.IN_MIN + norm * self.IN_SPAN

    def out_db_to_y(self, db, h):
        d = max(self.OUT_MIN, min(self.OUT_MAX, db))
        norm = (self.OUT_MAX - d) / self.OUT_SPAN
        return self.PAD_T + norm * (h - self.PAD_T - self.PAD_B)

    def y_to_out_db(self, y, h):
        avail = h - self.PAD_T - self.PAD_B
        if avail <= 0:
            return 0.0
        norm = max(0.0, min(1.0, (y - self.PAD_T) / avail))
        return self.OUT_MAX - norm * self.OUT_SPAN

    def transfer(self, x):
        if not self.enabled:
            return x
        k = max(0.5, self.knee)
        half_k = k / 2.0
        inv_r = 1.0 / max(1.0, self.ratio)
        if x <= self.threshold - half_k:
            y = x
        elif x >= self.threshold + half_k:
            y = self.threshold + (x - self.threshold) * inv_r
        else:
            dx = x - self.threshold + half_k
            y = x + (inv_r - 1.0) * (dx * dx) / (2.0 * k)
        return y + self.makeup

    def get_max_gain_reduction(self):
        if not self.enabled:
            return 0.0
        uncompressed = 0.0 + self.makeup
        compressed = self.transfer(0.0)
        return max(0.0, uncompressed - compressed)

    def _get_threshold_node_pos(self, w, h):
        x = self.in_db_to_x(self.threshold, w)
        y = self.out_db_to_y(self.threshold + self.makeup, h)
        return x, y

    def _get_ratio_node_pos(self, w, h):
        x = self.in_db_to_x(0.0, w)
        y = self.out_db_to_y(self.transfer(0.0), h)
        return x, y

    def _find_nearest_node(self, x, y, w, h, max_dist=22.0):
        tx, ty = self._get_threshold_node_pos(w, h)
        dt = math.hypot(x - tx, y - ty)
        rx, ry = self._get_ratio_node_pos(w, h)
        dr = math.hypot(x - rx, y - ry)
        if dt < max_dist and dt <= dr:
            return "threshold"
        elif dr < max_dist:
            return "ratio"
        return None

    def _on_drag_begin(self, _gesture, start_x, start_y):
        w = self.get_width()
        h = self.get_height()
        node = self._find_nearest_node(start_x, start_y, w, h)
        if node is not None:
            self._active_drag = node
            self.queue_draw()

    def _on_drag_update(self, gesture, offset_x, offset_y):
        if self._active_drag is None:
            return
        w = self.get_width()
        h = self.get_height()
        _ok, start_x, start_y = gesture.get_start_point()
        new_x = start_x + offset_x
        new_y = start_y + offset_y

        if self._active_drag == "threshold":
            new_th = self.x_to_in_db(new_x, w)
            self.threshold = max(-45.0, min(0.0, round(new_th * 2.0) / 2.0))
            new_out = self.y_to_out_db(new_y, h)
            new_mu = new_out - self.threshold
            self.makeup = max(0.0, min(24.0, round(new_mu * 2.0) / 2.0))
        elif self._active_drag == "ratio":
            new_out = self.y_to_out_db(new_y, h)
            rem = new_out - self.threshold - self.makeup
            if rem > 0.5:
                new_r = -self.threshold / rem
                self.ratio = max(1.0, min(20.0, round(new_r * 10.0) / 10.0))

        self.queue_draw()
        if self.on_params_changed:
            self.on_params_changed(self.threshold, self.ratio, self.attack, self.release, self.makeup, self.knee)

    def _on_drag_end(self, _gesture, _ox, _oy):
        self._active_drag = None
        self.queue_draw()

    def _on_motion(self, _ctrl, x, y):
        w = self.get_width()
        h = self.get_height()
        self._mouse_x = x
        self._mouse_y = y
        node = self._find_nearest_node(x, y, w, h)
        if node != self._hover_node:
            self._hover_node = node
            self.queue_draw()

    def _on_leave(self, _ctrl):
        if self._hover_node is not None:
            self._hover_node = None
            self.queue_draw()

    def _on_scroll(self, _ctrl, _dx, dy):
        if self._active_drag == "ratio" or self._hover_node == "ratio":
            self.ratio = max(1.0, min(20.0, round((self.ratio - dy * 0.2) * 10.0) / 10.0))
        else:
            self.knee = max(0.0, min(12.0, round((self.knee - dy * 0.5) * 2.0) / 2.0))
        self.queue_draw()
        if self.on_params_changed:
            self.on_params_changed(self.threshold, self.ratio, self.attack, self.release, self.makeup, self.knee)
        return True

    def _on_click(self, _gesture, n_press, x, y):
        if n_press == 2:
            w = self.get_width()
            h = self.get_height()
            node = self._find_nearest_node(x, y, w, h)
            if node == "threshold":
                self.threshold = -16.0
                self.makeup = 0.0
            elif node == "ratio":
                self.ratio = 4.0
            self.queue_draw()
            if self.on_params_changed:
                self.on_params_changed(self.threshold, self.ratio, self.attack, self.release, self.makeup, self.knee)

    def set_params_silent(self, threshold=None, ratio=None, attack=None, release=None, makeup=None, knee=None, enabled=None):
        if threshold is not None:
            self.threshold = max(-45.0, min(0.0, float(threshold)))
        if ratio is not None:
            self.ratio = max(1.0, min(20.0, float(ratio)))
        if attack is not None:
            self.attack = max(0.1, min(100.0, float(attack)))
        if release is not None:
            self.release = max(10.0, min(1000.0, float(release)))
        if makeup is not None:
            self.makeup = max(0.0, min(24.0, float(makeup)))
        if knee is not None:
            self.knee = max(0.0, min(12.0, float(knee)))
        if enabled is not None:
            self.enabled = bool(enabled)
        self.queue_draw()

    def _draw(self, _area, cr, w, h):
        # 1. Dark Console Gradient Background
        pat = cairo.LinearGradient(0, 0, 0, h)
        pat.add_color_stop_rgb(0.0, 0.07, 0.09, 0.12)
        pat.add_color_stop_rgb(1.0, 0.04, 0.05, 0.07)
        cr.set_source(pat)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Border
        cr.rectangle(0.5, 0.5, w - 1, h - 1)
        cr.set_source_rgba(0.20, 0.26, 0.34, 0.8)
        cr.set_line_width(1.0)
        cr.stroke()

        # 2. Gridlines - Input dB (X)
        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(8.5)
        for db in [-40, -30, -20, -10, 0]:
            x = self.in_db_to_x(db, w)
            cr.set_source_rgba(0.20, 0.28, 0.38, 0.25)
            cr.move_to(x, self.PAD_T)
            cr.line_to(x, h - self.PAD_B)
            cr.set_line_width(0.8)
            cr.stroke()

            # Axis tick label
            cr.set_source_rgba(0.50, 0.62, 0.75, 0.70)
            cr.move_to(x - 8, h - self.PAD_B + 14)
            cr.show_text(f"{db:+d}")

        # Gridlines - Output dB (Y)
        for db in [10, 0, -10, -20, -30, -40]:
            y = self.out_db_to_y(db, h)
            if db == 0:
                cr.set_source_rgba(0.35, 0.75, 1.0, 0.38)
                cr.set_line_width(1.2)
            else:
                cr.set_source_rgba(0.20, 0.28, 0.38, 0.20)
                cr.set_line_width(0.8)
            cr.move_to(self.PAD_L, y)
            cr.line_to(w - self.PAD_R, y)
            cr.stroke()

            cr.set_source_rgba(0.50, 0.62, 0.75, 0.70)
            cr.move_to(8, y + 3)
            cr.show_text(f"{db:+d}")

        # 3. 1:1 Unity Reference Line (Diagonal)
        cr.set_source_rgba(0.38, 0.48, 0.60, 0.35)
        cr.set_line_width(1.0)
        cr.set_dash([4.0, 4.0])
        cr.move_to(self.in_db_to_x(self.IN_MIN, w), self.out_db_to_y(self.IN_MIN, h))
        cr.line_to(self.in_db_to_x(0.0, w), self.out_db_to_y(0.0, h))
        cr.stroke()
        cr.set_dash([])

        # 4. Transfer Function Points
        pts = []
        for i in range(101):
            in_db = self.IN_MIN + self.IN_SPAN * (i / 100.0)
            out_db = self.transfer(in_db)
            pts.append((self.in_db_to_x(in_db, w), self.out_db_to_y(out_db, h)))

        # Shaded Gain Reduction Polygon (between 1:1 line + makeup and compressed curve)
        if self.enabled and pts:
            cr.move_to(pts[0][0], pts[0][1])
            for x, y in pts:
                cr.line_to(x, y)
            for i in range(100, -1, -1):
                in_db = self.IN_MIN + self.IN_SPAN * (i / 100.0)
                uncompressed_y = self.out_db_to_y(in_db + self.makeup, h)
                cr.line_to(self.in_db_to_x(in_db, w), uncompressed_y)
            cr.close_path()

            gr_pat = cairo.LinearGradient(0, self.PAD_T, 0, h - self.PAD_B)
            gr_pat.add_color_stop_rgba(0.0, 1.0, 0.45, 0.15, 0.32)
            gr_pat.add_color_stop_rgba(1.0, 1.0, 0.35, 0.10, 0.05)
            cr.set_source(gr_pat)
            cr.fill()

        # Compression Transfer Curve Stroke
        if pts:
            cr.move_to(pts[0][0], pts[0][1])
            for x, y in pts[1:]:
                cr.line_to(x, y)
            if self.enabled:
                cr.set_source_rgba(1.0, 0.62, 0.18, 0.95)
            else:
                cr.set_source_rgba(0.5, 0.55, 0.65, 0.5)
            cr.set_line_width(2.6)
            cr.stroke()

        # 5. Interactive Control Nodes
        tx, ty = self._get_threshold_node_pos(w, h)
        rx, ry = self._get_ratio_node_pos(w, h)

        active_target = self._active_drag if self._active_drag is not None else self._hover_node

        # Crosshairs for active target
        if active_target == "threshold":
            cr.set_source_rgba(1.0, 0.62, 0.20, 0.35)
            cr.set_line_width(1.0)
            cr.move_to(tx, self.PAD_T); cr.line_to(tx, h - self.PAD_B); cr.stroke()
            cr.move_to(self.PAD_L, ty); cr.line_to(w - self.PAD_R, ty); cr.stroke()
        elif active_target == "ratio":
            cr.set_source_rgba(0.35, 0.85, 1.0, 0.35)
            cr.set_line_width(1.0)
            cr.move_to(rx, self.PAD_T); cr.line_to(rx, h - self.PAD_B); cr.stroke()
            cr.move_to(self.PAD_L, ry); cr.line_to(w - self.PAD_R, ry); cr.stroke()

        # Threshold Node (Amber)
        is_th_active = (active_target == "threshold")
        if is_th_active:
            cr.arc(tx, ty, 16, 0, 2 * math.pi)
            cr.set_source_rgba(1.0, 0.62, 0.20, 0.25)
            cr.fill()

        cr.arc(tx, ty, 10 if is_th_active else 8, 0, 2 * math.pi)
        cr.set_source_rgba(0.08, 0.10, 0.14, 0.95)
        cr.fill_preserve()
        cr.set_source_rgb(1.0, 0.62, 0.20)
        cr.set_line_width(2.2 if is_th_active else 1.8)
        cr.stroke()

        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(7.0)
        cr.set_source_rgb(1.0, 0.62, 0.20)
        cr.move_to(tx - 3.5, ty + 2.5)
        cr.show_text("T")

        # Ratio Node (Cyan)
        is_r_active = (active_target == "ratio")
        if is_r_active:
            cr.arc(rx, ry, 16, 0, 2 * math.pi)
            cr.set_source_rgba(0.35, 0.85, 1.0, 0.25)
            cr.fill()

        cr.arc(rx, ry, 10 if is_r_active else 8, 0, 2 * math.pi)
        cr.set_source_rgba(0.08, 0.10, 0.14, 0.95)
        cr.fill_preserve()
        cr.set_source_rgb(0.35, 0.85, 1.0)
        cr.set_line_width(2.2 if is_r_active else 1.8)
        cr.stroke()

        cr.set_font_size(7.0)
        cr.set_source_rgb(0.35, 0.85, 1.0)
        cr.move_to(rx - 3.5, ry + 2.5)
        cr.show_text("R")

        # 6. Floating HUD Tooltip Badge
        if active_target is not None:
            max_gr = self.get_max_gain_reduction()
            hud_text = f"THRESH: {self.threshold:+.1f} dB  |  RATIO: {self.ratio:.1f}:1  |  MAKEUP: +{self.makeup:.1f} dB  |  MAX GR: -{max_gr:.1f} dB"
            cr.set_font_size(9.5)
            extents = cr.text_extents(hud_text)
            bw = extents.width + 18
            bh = 22
            target_x = tx if active_target == "threshold" else rx
            target_y = ty if active_target == "threshold" else ry
            bx = max(self.PAD_L, min(w - self.PAD_R - bw, target_x - bw / 2.0))
            by = target_y - 28 if target_y > self.PAD_T + 35 else target_y + 18

            cr.rectangle(bx, by, bw, bh)
            cr.set_source_rgba(0.08, 0.10, 0.14, 0.95)
            cr.fill_preserve()
            if active_target == "threshold":
                cr.set_source_rgb(1.0, 0.62, 0.20)
            else:
                cr.set_source_rgb(0.35, 0.85, 1.0)
            cr.set_line_width(1.2)
            cr.stroke()

            cr.set_source_rgb(0.95, 0.98, 1.0)
            cr.move_to(bx + 9, by + 15)
            cr.show_text(hud_text)

        # 7. Hardware Gain Reduction (GR) LED Meter on Right
        gr_x = w - self.PAD_R + 10
        gr_w = 26
        gr_y = self.PAD_T
        gr_h = h - self.PAD_T - self.PAD_B

        # Background slot
        cr.rectangle(gr_x, gr_y, gr_w, gr_h)
        cr.set_source_rgb(0.06, 0.08, 0.11)
        cr.fill_preserve()
        cr.set_source_rgba(0.25, 0.35, 0.45, 0.6)
        cr.set_line_width(1.0)
        cr.stroke()

        # Meter Header "GR"
        cr.select_font_face("Monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.0)
        cr.set_source_rgba(0.85, 0.60, 0.20, 0.9)
        cr.move_to(gr_x + 7, gr_y - 6)
        cr.show_text("GR")

        # Meter segments (from top 0 dB downward to -20 dB)
        max_gr = self.get_max_gain_reduction()
        active_frac = max(0.0, min(1.0, max_gr / 20.0))
        num_segs = 20
        seg_h = (gr_h - 4) / num_segs
        for s in range(num_segs):
            frac = s / float(num_segs)
            sy = gr_y + 2 + s * seg_h
            is_lit = (frac <= active_frac) and self.enabled

            if s < 6:
                col = (0.98, 0.72, 0.15)
            elif s < 13:
                col = (1.0, 0.50, 0.10)
            else:
                col = (0.95, 0.25, 0.25)

            if is_lit:
                cr.set_source_rgba(col[0], col[1], col[2], 0.92)
            else:
                cr.set_source_rgba(col[0], col[1], col[2], 0.12)
            cr.rectangle(gr_x + 3, sy + 0.5, gr_w - 6, seg_h - 1)
            cr.fill()


