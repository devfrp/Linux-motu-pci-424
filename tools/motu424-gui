    def _verify_fw(self, _btn):
        path = self.ent_fw_path.get_text().strip()
        if not os.path.isabs(path):
            path = os.path.join(HERE, path)
        res = verify_firmware_file(path)
        if not res.get("valid"):
            err = res.get("error", "Checksum validation failed")
            self.row_fw_stat.set_title("Validation Failed")
            self.row_fw_stat.set_subtitle(err)
            self.toast("Firmware check: " + err)
        else:
            sub = f"OK: {res['payload_length']} bytes, Sum32: {res['expected_checksum']}, Load: {res['load_address']}, Sections: {len(res['sections'])}"
            self.row_fw_stat.set_title("Valid HD Express Container")
            self.row_fw_stat.set_subtitle(sub)
            self.toast("Firmware verified successfully")

