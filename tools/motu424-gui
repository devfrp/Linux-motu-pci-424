HERE = os.path.dirname(os.path.abspath(__file__))

def find_binary(name):
    # Check current dir, tools dir, or PATH
    candidates = [
        os.path.join(HERE, name),
        os.path.join(HERE, "tools", name),
        os.path.join(os.path.dirname(HERE), "tools", name),
        shutil.which(name)
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return shutil.which(name)

CTL_BIN = find_binary("motu424-ctl")
PROBE_BIN = find_binary("motu424-probe")

def run_ctl(args, dev=None):
    if not CTL_BIN:
        return 127, "", "motu424-ctl not found in tools or PATH"
    cmd = [CTL_BIN] + (["-D", dev] if dev else []) + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)

def run_probe(bdf=None, offset=None, length=None):
    if not PROBE_BIN:
        return 127, "", "motu424-probe not found in tools or PATH"
    cmd = [PROBE_BIN]
    if bdf:
        cmd.append(bdf)
    if offset is not None:
        cmd.append(hex(offset) if isinstance(offset, int) else str(offset))
    if length is not None:
        cmd.append(hex(length) if isinstance(length, int) else str(length))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)

