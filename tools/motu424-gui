        row.append(scale)
        box.append(row)

        # Value Readout with Click-to-Reset to Unity (0.0 dB)
        lbl_val = Gtk.Label(label=fader_to_db_str(int(scale.get_value())))
        lbl_val.add_css_class("strip-val")
        lbl_val.set_tooltip_text("Click to reset to Unity (0.0 dB)")
        scale.connect("value-changed", lambda s: lbl_val.set_text(fader_to_db_str(int(s.get_value()))))
        c_reset = Gtk.GestureClick()
        c_reset.connect("pressed", lambda *_a: scale.set_value(100))
