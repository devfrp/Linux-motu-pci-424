# -----------------------------------------------------------------------------
# Firmware Container Inspector & Verifier (CLI & Headless capable)
# -----------------------------------------------------------------------------
def verify_firmware_file(path):
    """Validates HDExpress_FullImageRun.bin container header and checksum."""
    if not os.path.isfile(path):
        return {"valid": False, "error": f"File not found: {path}"}
    try:
        with open(path, "rb") as f:
            data = f.read()
    except Exception as e:
        return {"valid": False, "error": str(e)}

    if len(data) < 24:
        return {"valid": False, "error": f"File too small ({len(data)} < 24 bytes)"}

    # 24-byte container header: load_addr, hdr_len, payload_len, checksum, entry_point, version
    load_addr, hdr_len, payload_len, exp_csum, entry_pt, ver = struct.unpack_from("<IIIIII", data, 0)

    if hdr_len != 24:
        return {"valid": False, "error": f"Invalid header length: {hdr_len} (expected 24)"}

    if hdr_len + payload_len != len(data):
        return {"valid": False, "error": f"Size mismatch: header({hdr_len}) + payload({payload_len}) != file({len(data)})"}

    payload = data[hdr_len:]
    calc_csum = sum(payload) & 0xFFFFFFFF
    csum_ok = (calc_csum == exp_csum)

    # Parse sections
    sections = []
    sec_types = {
        0x1: "ARM32 SoC Firmware",
        0x5: "Pre-Config Record",
        0x6: "Xilinx Virtex FPGA Bitstream",
        0x7: "Post-Config Record"
    }
    off = hdr_len
    sec_idx = 0
    while off + 28 <= len(data):
        stype, data_off, ssize, sflags, stag, sr1, sr2 = struct.unpack_from("<IIIIIII", data, off)
        sections.append({
            "index": sec_idx,
            "type_code": hex(stype),
            "type_name": sec_types.get(stype, f"Type {hex(stype)}"),
            "file_offset": hex(off),
            "size_bytes": ssize,
            "flags": hex(sflags),
            "tag": hex(stag)
        })
        sec_idx += 1
        step = data_off + ssize
        if step <= 0:
            break
        off += step

    return {
        "valid": csum_ok,
        "filename": os.path.basename(path),
        "path": path,
        "file_size": len(data),
        "load_address": hex(load_addr),
        "header_length": hdr_len,
        "payload_length": payload_len,
        "entry_point": hex(entry_pt),
        "version": hex(ver),
        "expected_checksum": hex(exp_csum),
        "calculated_checksum": hex(calc_csum),
        "checksum_match": csum_ok,
        "sections": sections
    }

def cli_verify_fw(args):
    target = None
    for a in args:
        if a.startswith("--verify-fw="):
            target = a.split("=", 1)[1]
        elif a.startswith("--verify-firmware="):
            target = a.split("=", 1)[1]
    if not target:
        for idx, a in enumerate(args):
            if a in ("--verify-fw", "--verify-firmware") and idx + 1 < len(args) and not args[idx + 1].startswith("-"):
                target = args[idx + 1]
                break
    if not target:
        here = os.path.dirname(os.path.abspath(__file__))
        for c in ["vendor/HDExpress_FullImageRun.bin",
                  "/lib/firmware/HDExpress_FullImageRun.bin",
                  os.path.join(here, "vendor/HDExpress_FullImageRun.bin"),
                  os.path.join(os.path.dirname(here), "vendor/HDExpress_FullImageRun.bin")]:
            if os.path.isfile(c):
                target = c
                break
    if not target:
        target = "vendor/HDExpress_FullImageRun.bin"

    res = verify_firmware_file(target)
    if not res.get("valid"):
        print(f"\033[1;31m[ERROR]\033[0m Firmware verification failed for '{target}': {res.get('error', 'Checksum mismatch')}")
        sys.exit(1)

    print(f"\033[1;32m[OK]\033[0m Valid HD Express PCIe Container: {res['path']}")
    print(f"     File Size:         {res['file_size']:,} bytes")
    print(f"     Container Version: {res['version']}")
    print(f"     Load Address:      {res['load_address']}")
    print(f"     Entry Point:       {res['entry_point']}")
    print(f"     Payload Length:    {res['payload_length']:,} bytes")
    print(f"     Checksum:          {res['expected_checksum']} (Sum32 match: {res['checksum_match']})")
    print(f"     Sections ({len(res['sections'])}):")
    for sec in res['sections']:
        print(f"       • Section {sec['index']}: {sec['type_name']:<30} Size: {sec['size_bytes']:>7} bytes  (Flags: {sec['flags']}, Tag: {sec['tag']})")
    sys.exit(0)

for _arg in sys.argv[1:]:
    if _arg in ("--verify-fw", "--verify-firmware") or _arg.startswith(("--verify-fw=", "--verify-firmware=")):
        cli_verify_fw(sys.argv[1:])

