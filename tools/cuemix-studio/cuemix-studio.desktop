[Desktop Entry]
Type=Application
Name=CueMix Studio (motu424)
GenericName=Audio Mixer
GenericName[fr]=Console de mixage audio
Comment=Mixing console for the MOTU PCI-324/424 sound card
Comment[fr]=Console de mixage de la carte son MOTU PCI-324/424
Exec=cuemix-studio
Icon=audio-card
Terminal=false
Categories=AudioVideo;Audio;Mixer;
Keywords=MOTU;CueMix;mixer;ALSA;clock;patchbay;monitoring;
Keywords[fr]=MOTU;CueMix;mixage;ALSA;horloge;patchbay;écoute;
Actions=Simulate;

[Desktop Action Simulate]
Name=Preview the console (simulated rig)
Name[fr]=Aperçu de la console (rig simulé)
Exec=cuemix-studio --simulate
