# -----------------------------------------------------------------------------
# Main Application Window
# -----------------------------------------------------------------------------
class MotuGuiWindow(Adw.ApplicationWindow):
    def __init__(self, app, demo_mode=False):
        super().__init__(application=app, title="MOTU CueMix & Workbench Studio")
        self.set_default_size(1160, 760)
        self.demo_mode = demo_mode
        self.meters = []
        self._syncing = False
        self.settings_unlocked = False
        self.protected_widgets = []

        # Toast overlay for feedback
        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)

        # Main Layout Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True, hexpand=True)
        self.toast_overlay.set_child(main_box)

        # HeaderBar with ViewSwitcherTitle
        header = Adw.HeaderBar()
        self.title_switcher = Adw.ViewSwitcherTitle()
        header.set_title_widget(self.title_switcher)
        main_box.append(header)

        # Header start widgets: Refresh button & Card status indicator
        btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh hardware state (Ctrl+R)")
        btn_refresh.connect("clicked", lambda _: self.refresh_all())
        header.pack_start(btn_refresh)

        self.lbl_card_status = Gtk.Label(label="Scanning...")
        self.lbl_card_status.add_css_class("strip-cap")
        header.pack_start(self.lbl_card_status)

        # Header end widgets: Settings Lock button & Demo mode switch
        self.btn_lock = Gtk.Button(label="LOCKED", tooltip_text="Settings Lock: Protected with PIN 1234 to prevent accidental changes")
        self.btn_lock.add_css_class("btn-lock-locked")
        self.btn_lock.connect("clicked", lambda _: self._on_lock_button_clicked())
        header.pack_end(self.btn_lock)

        demo_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        demo_lbl = Gtk.Label(label="Demo Rig")
        demo_lbl.add_css_class("strip-cap")
        self.sw_demo = Gtk.Switch(active=self.demo_mode, tooltip_text="Toggle synthetic demo rig (for testing without card)")
        self.sw_demo.connect("state-set", self._on_demo_toggle)
        demo_box.append(demo_lbl)
        demo_box.append(self.sw_demo)
        header.pack_end(demo_box)

        # ViewStack (Main Sections)
        self.view_stack = Adw.ViewStack(vexpand=True, hexpand=True)
        self.title_switcher.set_stack(self.view_stack)
        main_box.append(self.view_stack)

        # 1. CueMix FX Mixing Console Tab (Default view on launch)
        page_mixer = self.build_mixer_tab()
        self.view_stack.add_titled_with_icon(page_mixer, "mixer", "Mixer Console", "audio-volume-high-symbolic")

        # 2. DSP Studio Tab (Dedicated top-level view)
        page_dsp = self.build_dsp_tab()
        self.view_stack.add_titled_with_icon(page_dsp, "dsp", "DSP Studio", "audio-card-symbolic")

        # 3. I/O Routing & Sync Tab
        page_routing = self.build_routing_tab()
        self.view_stack.add_titled_with_icon(page_routing, "routing", "I/O Routing", "network-transmit-receive-symbolic")

        # 4. Hardware Workbench Tab
        page_wb = self.build_workbench_tab()
        self.view_stack.add_titled_with_icon(page_wb, "workbench", "Workbench", "emblem-system-symbolic")

        # Set default tab to Mixer Console
        self.view_stack.set_visible_child_name("mixer")

        # Apply initial lock state across protected controls
        self._update_lock_state()

        # Start periodic level meter decay and background checks
        GLib.timeout_add(40, self._meter_tick)
        GLib.timeout_add_seconds(3, self._poll_hardware)

        self.refresh_all()

    def toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast.new(GLib.markup_escape_text(str(msg))))

    def open_dsp_channel(self, ch_idx):
        if hasattr(self, "dd_dsp_ch") and hasattr(self, "dsp_channel_names") and 0 <= ch_idx < len(self.dsp_channel_names):
            self.dd_dsp_ch.set_selected(ch_idx)
        self.view_stack.set_visible_child_name("dsp")
        name = self.dsp_channel_names[ch_idx] if hasattr(self, "dsp_channel_names") and 0 <= ch_idx < len(self.dsp_channel_names) else f"Ch {ch_idx+1:02d}"
        self.toast(f"DSP Studio: {name}")

    def _on_lock_button_clicked(self):
        if self.settings_unlocked:
            self.settings_unlocked = False
            self._update_lock_state()
            self.toast("Settings Locked (PIN 1234 required to edit)")
        else:
            self._show_unlock_dialog()

    def _show_unlock_dialog(self):
        dlg = Adw.MessageDialog(
            transient_for=self,
            heading="Unlock Hardware Settings",
            body="Enter security password to allow modifications to hardware clock, routing, and driver parameters."
        )
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("unlock", "Unlock")
        dlg.set_response_appearance("unlock", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("unlock")
        dlg.set_close_response("cancel")

        entry_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10)
        entry = Gtk.Entry(hexpand=True)
        entry.set_visibility(False)
        entry.set_invisible_char("●")
        entry.set_placeholder_text("Enter PIN (1234)")
        entry_box.append(entry)
        dlg.set_extra_child(entry_box)

        def on_response(_d, response):
            if response == "unlock":
                pwd = entry.get_text()
                if pwd == "1234":
                    self.settings_unlocked = True
                    self._update_lock_state()
                    self.toast("Settings Unlocked (Editing Enabled)")
                else:
                    self.toast("Incorrect password! Settings remain locked.")

        dlg.connect("response", on_response)
        entry.connect("activate", lambda _: dlg.response("unlock"))
        dlg.present()

    def _update_lock_state(self):
        if self.settings_unlocked:
            self.btn_lock.set_label("UNLOCKED")
            self.btn_lock.remove_css_class("btn-lock-locked")
            self.btn_lock.add_css_class("btn-lock-unlocked")
            self.btn_lock.set_tooltip_text("Settings Unlocked. Click to re-lock with PIN 1234.")
        else:
            self.btn_lock.set_label("LOCKED")
            self.btn_lock.remove_css_class("btn-lock-unlocked")
            self.btn_lock.add_css_class("btn-lock-locked")
            self.btn_lock.set_tooltip_text("Settings Locked (PIN 1234). Click to unlock.")

        for w in list(self.protected_widgets):
            try:
                w.set_sensitive(self.settings_unlocked)
            except Exception:
                pass

    def _on_demo_toggle(self, _sw, state):
        self.demo_mode = state
        self.toast(f"{'Enabled' if state else 'Disabled'} synthetic demo rig")
        self.rebuild_mixer_ui()
        if hasattr(self, "rebuild_routing_ui"):
            self.rebuild_routing_ui()
        self.refresh_all()
        return False

    # -------------------------------------------------------------------------
    # TAB 1: Probe & BARs Workbench
    # -------------------------------------------------------------------------
    def build_probe_tab(self):
        scrolled = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        clamp = Adw.Clamp(maximum_size=980)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin_top=16, margin_bottom=24, margin_start=16, margin_end=16)
        clamp.set_child(box)
        scrolled.set_child(clamp)

        # Group 1: PCI Hardware Detection
        self.grp_card = Adw.PreferencesGroup(title="MOTU PCI/PCIe Cards (Vendor 0x137A)",
                                             description="Physical cards detected on the host system bus")
        self.card_rows = []
        box.append(self.grp_card)

        # Group 2: Interactive motu424-probe Runner
        grp_probe = Adw.PreferencesGroup(title="Hardware Memory &amp; BAR Probe",
                                         description="Run motu424-probe to scan BAR spaces and examine bank registers")
        
        row_actions = Adw.ActionRow(title="Direct Bus Probe", subtitle="Enumerate all BARs and dump bank control words")
        btn_run_probe = Gtk.Button(label="Run Probe", halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        btn_run_probe.add_css_class("suggested-action")
        btn_run_probe.connect("clicked", lambda _: self._execute_probe(None, None))
        row_actions.add_suffix(btn_run_probe)
        grp_probe.add(row_actions)

        # Quick targeted dumps
        row_quick = Adw.ActionRow(title="Targeted Bank Dumps", subtitle="Dump 4KB Window-B memory banks (card must be unbound)")
        b_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, valign=Gtk.Align.CENTER)
        
        btn_bank0 = Gtk.Button(label="Bank 0 (0xC0000)")
        btn_bank0.connect("clicked", lambda _: self._execute_probe(0xC0000, 0x1000))
        b_box.append(btn_bank0)

        btn_bank1 = Gtk.Button(label="Bank 1 (0x100000)")
        btn_bank1.connect("clicked", lambda _: self._execute_probe(0x100000, 0x1000))
        b_box.append(btn_bank1)

        row_quick.add_suffix(b_box)
        grp_probe.add(row_quick)

        # Custom offset / length
        row_custom = Adw.ActionRow(title="Custom Range Dump")
        c_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, valign=Gtk.Align.CENTER)
        self.ent_offset = Gtk.Entry(placeholder_text="Offset (e.g. 0xc0000)", width_chars=14)
        self.ent_len = Gtk.Entry(placeholder_text="Length (e.g. 0x200)", width_chars=12)
        btn_dump_custom = Gtk.Button(label="Dump Range")
        btn_dump_custom.connect("clicked", self._on_custom_dump)
        c_box.append(self.ent_offset)
        c_box.append(self.ent_len)
        c_box.append(btn_dump_custom)
        row_custom.add_suffix(c_box)
        grp_probe.add(row_custom)

        box.append(grp_probe)
        self.protected_widgets.extend([btn_run_probe, btn_bank0, btn_bank1, btn_dump_custom])

        # Hex / Probe output viewer
        grp_out = Adw.PreferencesGroup(title="Probe &amp; Register Output")
        self.txt_probe_output = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        self.txt_probe_output.add_css_class("hexdump-view")
        self.txt_probe_output.set_size_request(-1, 280)
        sc_txt = Gtk.ScrolledWindow()
        sc_txt.set_child(self.txt_probe_output)
        grp_out.add(sc_txt)
        box.append(grp_out)

        return scrolled

    def _execute_probe(self, offset, length):
        cards = get_motu_cards()
        bdf = cards[0]["bdf"] if cards else None
        self.txt_probe_output.get_buffer().set_text("Running probe...\n")
        
        def run():
            rc, out, err = run_probe(bdf, offset, length)
            res = out if out else err
            GLib.idle_add(lambda: self.txt_probe_output.get_buffer().set_text(res or "No output returned."))
            GLib.idle_add(lambda: self.toast("Probe completed" if rc == 0 else "Probe exited with status " + str(rc)))
        threading.Thread(target=run, daemon=True).start()

    def _on_custom_dump(self, _btn):
        off_str = self.ent_offset.get_text().strip()
        len_str = self.ent_len.get_text().strip()
        try:
            off = int(off_str, 16) if off_str.startswith("0x") else int(off_str)
            length = int(len_str, 16) if len_str.startswith("0x") else int(len_str)
            self._execute_probe(off, length)
        except ValueError:
            self.toast("Invalid hex or integer value for offset/length")

