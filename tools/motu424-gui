    def rebuild_mixer_ui(self):
        # Clear existing tabs
        while self.mix_nb.get_n_pages() > 0:
            self.mix_nb.remove_page(0)
        self.meters = []

        controls = demo_controls() if self.demo_mode else self._fetch_live_controls()

        # Build Mix 1-4 Tabs
        bus_names = ["Mix 1 (Main Out)", "Mix 2 (Aux 1)", "Mix 3 (Aux 2)", "Mix 4 (Aux 3)"]
        for bus_idx in range(4):
            page_bus = self._build_bus_page(bus_idx, controls)
            self.mix_nb.append_page(page_bus, Gtk.Label(label=bus_names[bus_idx]))

    def _fetch_live_controls(self):
        if not CTL_BIN:
            return demo_controls()
        rc, out, _ = run_ctl(["list"])
        if rc != 0 or not out.strip():
            return demo_controls()
        # Parse list output
        ctrls = []
        for line in out.splitlines():
            if " = " in line:
                left, val = line.split(" = ", 1)
                parts = left.rsplit(None, 1)
                if len(parts) == 2:
                    ctrls.append({"name": parts[0].strip(), "type": parts[1].strip(), "value": val.strip(), "min": 0, "max": 127})
        return ctrls or demo_controls()

