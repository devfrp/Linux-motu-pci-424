    def _create_channel_strip(self, bus_prefix, tok, vol_ctrl, pan_ctrl=None):
        slot, bank, idx = tok_parts(tok)
        bank_lower = bank.lower() if bank else "ch"
        
        if bank_lower in ("analog", "main", "phones"):
            category = "analog"
            badge_cls = "analog"
            badge_text = "ANLG"
        elif "adat" in bank_lower:
            category = "digital"
            badge_cls = "adat"
            badge_text = "ADAT"
        elif any(k in bank_lower for k in ("aes", "spdif", "tdif")):
            category = "digital"
            badge_cls = "aes"
            badge_text = "AES" if "aes" in bank_lower else "S/PD"
        else:
            category = "analog"
            badge_cls = "analog"
            badge_text = "CH"

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, vexpand=True)
        box.add_css_class("strip")
        box._category = category

        # Header with Bank Badge and Channel ID
        hdr_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        hdr_box.add_css_class("strip-header")
        badge = Gtk.Label(label=f"{slot + ' ' if slot else ''}{badge_text}")
        badge.add_css_class("bank-badge")
        badge.add_css_class(badge_cls)
        lbl_ch = Gtk.Label(label=f"{idx + 1:02d}")
        lbl_ch.add_css_class("strip-title")
        hdr_box.append(badge)
        hdr_box.append(lbl_ch)
        box.append(hdr_box)

        # Rotary Pan Knob with numerical/directional readout
        pan_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        initial_pan = int(pan_ctrl.get("value", 0)) if pan_ctrl else 0
        lbl_pan = Gtk.Label(label=pan_to_str(initial_pan))
        lbl_pan.add_css_class("strip-pan-val")
        pan_knob = Knob(-100, 100, initial_pan, lambda v: lbl_pan.set_text(pan_to_str(v)))
        pan_box.append(pan_knob)
        pan_box.append(lbl_pan)
        box.append(pan_box)

        # Fader, Meter & dB Scale Markings
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2, vexpand=True, valign=Gtk.Align.FILL)
        meter = Meter()
        self.meters.append(meter)
        fader_scale = DbScale(compact=True)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.VERTICAL, 0, 127, 1)
