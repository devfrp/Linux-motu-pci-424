    def rebuild_routing_ui(self):
        while self.routing_nb.get_n_pages() > 0:
            self.routing_nb.remove_page(0)

        # Clear previous routing widgets from protected list
        self.protected_widgets = [w for w in self.protected_widgets if not getattr(w, "_is_routing_widget", False)]

        controls = demo_controls() if self.demo_mode else self._fetch_live_controls()

        page_in = self._build_inputs_page(controls)
