class MotuApp(Adw.Application):
    def __init__(self, demo_mode=False):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.demo_mode = demo_mode

    def do_activate(self):
        # Force dark studio theme
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        
        # Install CSS
        prov = Gtk.CssProvider()
        prov.load_from_data(CUSTOM_CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        win = MotuGuiWindow(self, demo_mode=self.demo_mode)
        win.present()


def main():
    app = MotuApp(demo_mode=DEMO)
    # Filter arguments for Gtk.Application
    return app.run([sys.argv[0]])


if __name__ == "__main__":
