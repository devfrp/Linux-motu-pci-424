# -----------------------------------------------------------------------------
# Studio Audio Utilities: Decibel and Pan Formatter
# -----------------------------------------------------------------------------
def fader_to_db_str(val):
    """Maps 0..127 MIDI/CueMix fader value to studio dB string."""
    if val <= 0:
        return "-∞ dB"
    if val == 100:
        return "0.0 dB"
    if val > 100:
        db = ((val - 100) / 27.0) * 6.0
        return f"+{db:.1f} dB"
    ratio = val / 100.0
    db = 40.0 * math.log10(ratio)
    return f"{db:.1f} dB"

def pan_to_str(val):
    """Formats -100..100 pan value to studio pan notation."""
    if val == 0:
        return "< C >"
    elif val < 0:
        return f"L {abs(val)}"
    else:
        return f"R {val}"

