    def build_mixer_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True, hexpand=True)
        
        # Sub-Notebook for Mixer Tabs (Buses, Inputs, Outputs, Clock)
