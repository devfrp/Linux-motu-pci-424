    def _refresh_diag(self):
        lines = ["=== MOTU PCI / PCIe Detection ==="]
        cards = get_motu_cards()
        if cards:
            for c in cards:
                lines.append(f"  [{c['bdf']}] {c['model']} (Device {c['device_id']}) - Driver: {c['driver']}, IRQ: {c['irq']}")
                for b in c["bars"]:
                    lines.append(f"     BAR{b['index']}: {hex(b['start'])}..{hex(b['end'])} ({b['size'] // 1024} KB) - {b['desc']}")
        else:
            lines.append("  No physical MOTU PCI card found on host bus.")

        lines.append("\n=== ALSA Sound Cards (/proc/asound/cards) ===")
        try:
            with open("/proc/asound/cards") as f:
                lines.append(f.read().strip())
        except Exception as e:
            lines.append(f"  Error reading cards: {e}")

        lines.append("\n=== Driver Module Status ===")
        m = get_module_info()
        lines.append(f"  Loaded: {'YES' if m['loaded'] else 'NO'}")
        dsp_active = m["parameters"].get("enable_dsp") in ("Y", "1", "true", "True")
        lines.append(f"  On-Board DSP Engine: {'ACTIVE' if dsp_active else 'OFF (Pass-through by default)'}")
        if m["parameters"]:
            for k, v in m["parameters"].items():
                lines.append(f"    {k} = {v}")

        self.txt_diag.get_buffer().set_text("\n".join(lines))

    # -------------------------------------------------------------------------
    # Periodic Updates & Polling
    # -------------------------------------------------------------------------
    def _meter_tick(self):
        # Animate demo meters slightly if in demo mode
        if self.demo_mode and self.meters:
            import random
            for m in self.meters:
                m.set_level(random.uniform(0.1, 0.75))
                m.decay(0.04)
        return True

    def _poll_hardware(self):
        cards = get_motu_cards()
        if self.demo_mode:
            self.lbl_card_status.set_text("DEMO RIG: 24I/O + 1224 (Simulated)")
        elif cards:
            c = cards[0]
            self.lbl_card_status.set_text(f"HARDWARE: {c['model']} ({c['driver']})")
        else:
            self.lbl_card_status.set_text("NO CARD (Run with Demo Rig)")
        return True

    def refresh_all(self):
        cards = get_motu_cards()
        self._poll_hardware()
        
        # Populate Probe Tab Card List
        for r in self.card_rows:
            self.grp_card.remove(r)
        self.card_rows.clear()

        if cards:
            for c in cards:
                row = Adw.ActionRow(title=f"{c['model']} [{c['bdf']}]",
                                   subtitle=f"Driver: {c['driver']} | IRQ: {c['irq']} | Revision: {c['revision']}")
                self.grp_card.add(row)
                self.card_rows.append(row)
        else:
            row = Adw.ActionRow(title="No MOTU card detected",
                                subtitle="Insert MOTU PCI-324/424 or PCIe-424 card to begin hardware probing")
            self.grp_card.add(row)
            self.card_rows.append(row)

        # Update module row in firmware tab
        mod = get_module_info()
        if mod["loaded"]:
            dsp_active = mod["parameters"].get("enable_dsp") in ("Y", "1", "true", "True")
            self.row_mod_state.set_title("Driver Module: Loaded")
            self.row_mod_state.set_subtitle(f"Active parameters: {len(mod['parameters'])} | DSP: {'Active' if dsp_active else 'Off (Pass-through by default)'}")
            if hasattr(self, "sw_dsp"):
                self.sw_dsp.set_active(dsp_active)
            if hasattr(self, "sw_dsp_enable"):
                self.sw_dsp_enable.set_active(dsp_active)
        else:
            self.row_mod_state.set_title("Driver Module: Not Loaded")
            self.row_mod_state.set_subtitle("Load motu424.ko after card is detected (DSP: Off by default)")

        self._refresh_diag()
        self._refresh_dmesg()
        self._verify_fw(None)


