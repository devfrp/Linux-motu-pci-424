    def _on_eq_visual_changed(self, band_idx, band):
        if getattr(self, "_eq_updating", False) or band_idx >= len(self._eq_controls):
            return
        self._eq_updating = True
        try:
            ctrls = self._eq_controls[band_idx]
            ctrls["sw_en"].set_active(band.enabled)
            ctrls["sc_freq"].set_value(band.freq)
            freq_str = f"{int(band.freq)} Hz" if band.freq < 1000 else f"{band.freq/1000:.1f} kHz"
            ctrls["lbl_freq"].set_text(freq_str)
            if "sc_gain" in ctrls:
                ctrls["sc_gain"].set_value(band.gain)
                ctrls["lbl_gain"].set_text(f"{band.gain:+.1f} dB")
            if "sc_q" in ctrls:
                ctrls["sc_q"].set_value(band.q)
                ctrls["lbl_q"].set_text(f"Q: {band.q:.1f}")
        finally:
            self._eq_updating = False

    def _on_eq_slider_changed(self, band_idx):
        if getattr(self, "_eq_updating", False) or band_idx >= len(self._eq_controls):
            return
        self._eq_updating = True
        try:
            ctrls = self._eq_controls[band_idx]
            en = ctrls["sw_en"].get_active()
            freq = ctrls["sc_freq"].get_value()
            gain = ctrls["sc_gain"].get_value() if "sc_gain" in ctrls else 0.0
            q = ctrls["sc_q"].get_value() if "sc_q" in ctrls else 0.707

            freq_str = f"{int(freq)} Hz" if freq < 1000 else f"{freq/1000:.1f} kHz"
            ctrls["lbl_freq"].set_text(freq_str)
            if "lbl_gain" in ctrls:
                ctrls["lbl_gain"].set_text(f"{gain:+.1f} dB")
            if "lbl_q" in ctrls:
                ctrls["lbl_q"].set_text(f"Q: {q:.1f}")

            self.visual_eq.set_band_silent(band_idx, freq=freq, gain=gain, q=q, enabled=en)
        finally:
            self._eq_updating = False

    def _apply_eq_preset(self, preset_key):
        preset = VisualEQ.PRESETS.get(preset_key)
        if not preset or len(self._eq_controls) < 5:
            return
        self._eq_updating = True
        try:
            for idx, (en, freq, gain, q) in enumerate(preset["bands"]):
                ctrls = self._eq_controls[idx]
                ctrls["sw_en"].set_active(en)
                ctrls["sc_freq"].set_value(freq)
                freq_str = f"{int(freq)} Hz" if freq < 1000 else f"{freq/1000:.1f} kHz"
                ctrls["lbl_freq"].set_text(freq_str)
                if "sc_gain" in ctrls:
                    ctrls["sc_gain"].set_value(gain)
                    ctrls["lbl_gain"].set_text(f"{gain:+.1f} dB")
                if "sc_q" in ctrls:
                    ctrls["sc_q"].set_value(q)
                    ctrls["lbl_q"].set_text(f"Q: {q:.1f}")
                self.visual_eq.set_band_silent(idx, freq=freq, gain=gain, q=q, enabled=en)
        finally:
            self._eq_updating = False
        self.toast(f"Loaded EQ Preset: {preset['name']}")

