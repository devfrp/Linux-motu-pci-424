def get_motu_cards():
    """Scans /sys/bus/pci/devices for vendor 0x137A (Mark of the Unicorn)."""
    cards = []
    base = "/sys/bus/pci/devices"
    models = {
        "0x0003": "MOTU PCI-324",
        "0x0004": "MOTU PCI-424",
        "0x0005": "MOTU PCIe-424 (HD Express)"
    }
    if not os.path.isdir(base):
        return cards
    for d in sorted(os.listdir(base)):
        p = os.path.join(base, d)
        def rd(attr):
            try:
                with open(os.path.join(p, attr)) as f:
                    return f.read().strip()
            except OSError:
                return "?"
        vendor = rd("vendor").lower()
        if vendor != MOTU_VENDOR:
            continue
        dev_id = rd("device").lower()
        drv_path = os.path.join(p, "driver")
        bound_drv = os.path.basename(os.path.realpath(drv_path)) if os.path.exists(drv_path) else "(unbound)"
        
        # Read BAR resources
        bars = []
        res_file = os.path.join(p, "resource")
        if os.path.isfile(res_file):
            try:
                with open(res_file) as f:
                    for i, line in enumerate(f):
                        parts = line.strip().split()
                        if len(parts) >= 3:
                            start = int(parts[0], 16)
                            end = int(parts[1], 16)
                            flags = int(parts[2], 16)
                            size = end - start + 1 if start else 0
                            if size > 0:
                                is_io = bool(flags & 0x100)
                                is_mem = bool(flags & 0x200)
                                desc = "I/O port bridge" if is_io else (
                                    "Window A (>=8MB)" if size >= 0x800000 else (
                                    "Window B (~4MB audio aperture)" if size >= 0x200000 else "Small MMIO"
                                ))
                                bars.append({
                                    "index": i, "start": start, "end": end,
                                    "size": size, "flags": flags,
                                    "is_io": is_io, "is_mem": is_mem, "desc": desc
                                })
            except Exception:
                pass

        cards.append({
            "bdf": d,
            "device_id": dev_id,
            "model": models.get(dev_id, f"Unknown MOTU ({dev_id})"),
            "revision": rd("revision"),
            "irq": rd("irq"),
            "driver": bound_drv,
            "bars": bars
        })
    return cards

def get_module_info():
    """Checks if motu424 kernel module is loaded and retrieves active parameters."""
    loaded = os.path.isdir("/sys/module/motu424")
    params = {}
    if loaded:
        param_dir = "/sys/module/motu424/parameters"
        if os.path.isdir(param_dir):
            for f in os.listdir(param_dir):
                try:
                    with open(os.path.join(param_dir, f)) as pf:
                        params[f] = pf.read().strip()
                except Exception:
                    pass
    return {"loaded": loaded, "parameters": params}

def get_dmesg_motu():
    """Fetches dmesg log entries mentioning motu or 137a."""
    try:
        p = subprocess.run(["dmesg"], capture_output=True, text=True, timeout=5)
        lines = []
        for line in p.stdout.splitlines():
            if any(k in line.lower() for k in ("motu", "137a", "pci424", "pcie424")):
                lines.append(line)
        return "\n".join(lines[-100:]) if lines else "No motu424 kernel log entries found."
    except Exception as e:
        return f"Could not read dmesg: {e}"



# -----------------------------------------------------------------------------
# CueMix Data Model & Demo Rig Generator
# -----------------------------------------------------------------------------
_BANKS = ("Analog", "ADAT", "TDIF", "AES", "SPDIF", "Main", "Phones")
_CHAN = r"((?:[A-D] )?(?:(?:%s) )?\d+)" % "|".join(_BANKS)
_IN = re.compile(r"^Input %s (Trim Volume|Pad Switch|Phase Switch|Stereo Switch|Mute Switch)$" % _CHAN)
_MAS = re.compile(r"^Mix (\d+) Master Volume$")
_MMU = re.compile(r"^Mix (\d+) Mute Switch$")
_SND = re.compile(r"^Mix (\d+) Input %s (Volume|Pan|Mute Switch|Solo Switch)$" % _CHAN)
_OUT = re.compile(r"^Output %s (Volume|Mute Switch|Stereo Switch|Source)$" % _CHAN)
_TOKP = re.compile(r"^(?:([A-D]) )?(?:(%s) )?(\d+)$" % "|".join(_BANKS))

def tok_parts(tok):
    m = _TOKP.match(tok)
    if not m:
        return ("", "", 0)
    return (m.group(1) or "", m.group(2) or "", int(m.group(3)))

def tok_label(tok):
    slot, bank, idx = tok_parts(tok)
    prefix = f"{slot} " if slot else ""
    return f"{prefix}{bank} {idx + 1}" if bank else f"Ch {idx + 1}"

